# GreenPrompt AI Backend Configuration

APP_NAME=GreenPrompt AI
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
PIPELINE_VERSION=1.0

# LLM Provider (optimizer)
LLM_PROVIDER=trained_model
LLM_MODEL=
TRAINED_MODEL_PATH=models/greenprompt_model
TRAINED_MODEL_DEVICE=auto
OPTIMIZER_NUM_CANDIDATES=5
OPTIMIZER_NUM_BEAMS=5
OPTIMIZER_MAX_NEW_TOKENS=96
SEMANTIC_SIMILARITY_THRESHOLD=0.50
# Merge rule-based output constraints with FLAN-T5 candidates (does not replace model)
ENABLE_CONSTRAINT_RULES=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Limits
MAX_PROMPT_LENGTH=10000
DATASET_DIR=Dataset

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Logging
LOG_TO_FILE=true
LOG_FULL_PROMPT=false

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Model recommendation scoring: equal_gmes | dynamic_dgmes
RECOMMENDATION_SCORING_MODE=dynamic_dgmes
